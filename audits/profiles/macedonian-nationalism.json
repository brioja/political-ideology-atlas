    {
      "text": "A country should not have to change its name or national symbols at a neighbour's demand as a condition of joining international organisations.",
      "value": 2,
      "rationale": "The Greek veto, the Prespa name change and VMRO-DPMNE's call of the deal a betrayal make this central to the movement.",
      "sources": [
        "s4",
        "s5"
      ],
      "addedAs": "national-self-determination"
    },
    {
      "text": "A national church should be self-governing and independent of the church of another nation.",
      "value": 2,
      "rationale": "Misirkov demanded restoring the Archbishopric of Ohrid and the Macedonian Orthodox Church split from the Serbian church in 1967, now a cultural pillar of the movement.",
      "sources": [
        "s1",
        "s3"
      ],
      "declined": "Specific to the Macedonian and Serbian churches; not a general contested question."
    },
    {
      "text": "A people's own standardised language should be taught in schools and church rather than the language of a neighbouring nation.",
      "value": 2,
      "rationale": "Misirkov proposed a Macedonian standard for schools and services, and codification in 1945 realised it.",
      "sources": [
        "s1",
        "s3"
      ],
      "declined": "Language standardisation is specific to this case; revive-national-language and single-official-language cover the nearest themes."
    }
  ],
