  "missingStatements": [
    {
      "text": "A region should collect its own taxes and pass the central government only an agreed share.",
      "value": 2,
      "rationale": "Base 6 of 1892 gave Catalonia taxation and the modern movement presses for fiscal control, though the existing regional-revenue statement partly captures it.",
      "sources": [
        "s2",
        "s3"
      ],
      "addedAs": "regional-revenue-retention"
    },
    {
      "text": "A national parliament or court should not be able to overturn a statute that the voters of a region approved in a referendum.",
      "value": 2,
      "rationale": "The 2010 Constitutional Court ruling on the 2006 statute approved by 73% of voters triggered the right-to-decide mobilisation.",
      "sources": [
        "s1",
        "s3"
      ],
      "declined": "Specific to Spain's Constitutional Court dispute; covered loosely by right-to-secede and national-self-determination."
    }
  ],
