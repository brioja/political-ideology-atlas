    {
      "text": "Northern Ireland should be able to leave the United Kingdom without joining the Republic of Ireland.",
      "value": 2,
      "rationale": "The defining aim of the ideology is an independent or dominion Northern Ireland that is neither UK-governed nor part of a united Ireland.",
      "sources": [
        "s1"
      ],
      "addedAs": "right-to-secede"
    },
    {
      "text": "A constitutional change should require the approval of two-thirds of voters in a referendum.",
      "value": 2,
      "rationale": "Common Sense says its constitution and any change to Northern Ireland's status need at least two-thirds support in a referendum.",
      "sources": [
        "s2"
      ],
      "declined": "A procedural detail of one party's constitutional draft, not a question other ideologies would take sides on."
    },
    {
      "text": "In a deeply divided society, major communities should share executive power through permanent coalition rather than simple majority rule.",
      "value": 2,
      "rationale": "Common Sense argues majority rule is undemocratic in divided societies and proposes proportional executive posts for all main parties.",
      "sources": [
        "s2"
      ],
      "addedAs": "power-sharing-divided-societies"
    }
  ],
