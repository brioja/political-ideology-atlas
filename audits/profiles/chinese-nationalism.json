    },
    {
      "title": "Nationality / Minzu (Uradyn Bulag, Made in China Journal)",
      "url": "https://madeinchinajournal.com/2020/09/04/nationality-民族/",
      "note": "Short scholarly account of how Nationalists and Communists defined the Chinese nation."
    },
    {
