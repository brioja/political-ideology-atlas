{
  "id": "black-separatism",
  "name": "Black separatism",
  "auditedAt": "2026-11-05",
  "auditor": "claude-sonnet-5-5",
  "rules": 3,
  "summary": "Black separatism holds that Black Americans, descended from slaves and refused equality by white America, should separate from it and govern their own community or state. The strand audited demands a separate territory with land and support from the former slave masters as reparations, control of the community's own economy and politics, and self-defence, and distinguishes voluntary separation from segregation imposed by whites.",
  "scope": "Territorial separatism in the United States: the Nation of Islam's Muslim Program and Malcolm X's early 1960s speeches as its spokesman, and the Provisional Government of the Republic of New Afrika (1968 Declaration of Independence, New Afrikan Creed, Malcolm X Doctrine). It excludes Garveyite return to Africa, Malcolm X's later post-Nation of Islam positions, and the Nation of Islam's racial theology; strands seeking only ethnic institutions inside the US are noted but not the core.",
  "wikipedia": "https://en.wikipedia.org/wiki/Black_separatism",
  "furtherReading": [
    {
      "title": "Black separatism (Wikipedia)",
      "url": "https://en.wikipedia.org/wiki/Black_separatism",
      "note": "Overview of strands from Delany and Garvey to the Nation of Islam."
    },
    {
      "title": "Separating, in PROTEST: The Making of African American Identity (National Humanities Center)",
      "url": "https://nationalhumanitiescenter.org/pds/maai3/protest/text8/text8read.htm",
      "note": "Short framing of Malcolm X and the move from integration to separation, with the 1964 speech."
    },
    {
      "title": "Malcolm X: Collected Speeches, Debates and Interviews (1960-1965)",
      "url": "https://web.mst.edu/lib-circ/files/special%20collections/mxebook.pdf",
      "note": "Free full text of the speeches, including the Nation of Islam period."
    }
  ],
  "sources": [
    {
      "id": "s1",
      "kind": "primary",
      "title": "Malcolm X: Collected Speeches, Debates and Interviews (1960-1965)",
      "author": "Malcolm X (Missouri S&T library copy)",
      "url": "https://web.mst.edu/lib-circ/files/special%20collections/mxebook.pdf",
      "usedFor": "Nation of Islam-era statements on separation versus segregation, separate states, intermarriage, economic control, back pay and self-defence."
    },
    {
      "id": "s2",
      "kind": "scholarly",
      "title": "Subjugated Territory: The New Afrikan Independence Movement and the Space of Black Power (LSU dissertation)",
      "author": "Paul Karolczyk",
      "url": "https://www.alwelaie.com/website/thesesFiles/Subjugated%20Territory-%20The%20New%20Afrikan%20Independence%20Movement%20and%20the%20Space%20of%20Black%20Power.pdf",
      "usedFor": "Reproduces the Muslim Program point 4, the 1968 New Afrikan Declaration of Independence and the 1969 New Afrikan Creed, and describes the movement."
    }
