  "missingStatements": [
    {
      "text": "The army should be permanently abolished and its budget spent on education and culture.",
      "value": 2,
      "rationale": "The 1948 abolition, written into Article 12, and the conversion of the Bellavista barracks into the National Museum are defining national symbols.",
      "sources": [
        "s3",
        "s4"
      ],
      "addedAs": "abolish-armed-forces"
    },
    {
      "text": "A country's national identity rests on being more democratic and peaceful than its neighbors.",
      "value": 2,
      "rationale": "Blecha describes institutional democracy and peace as one pillar of the narrative of Costa Rican superiority over Central America.",
      "sources": [
        "s2"
      ],
      "declined": "Specific to one country's national narrative of superiority over its neighbours; no neutral statement other ideologies could take a side on, and the army-abolition statement already covers the policy."
    }
  ],
  "notes": "Strands differ: a civic mainstream proud of democracy, peace and welfare; a Catholic nationalism; a secular elite current linked to Theosophy; and a xenophobic fringe with anti-Nicaraguan campaigns. Scholars such as Molina and Kordick treat the exceptionalist and whiteness myths as distortions.",
